---
interface ValueItem {
  title: string;
  body: string;
}

interface ProofItem {
  label: string;
  value: string;
}

interface Props {
  audience: string;
  eyebrow: string;
  hook: string;
  subhead: string;
  leadLabel: string;
  cta: string;
  ctaSupport: string;
  tone: "women" | "tic";
  valueIntro: string;
  values: ValueItem[];
  credibilityTitle: string;
  credibility: string[];
  proof: ProofItem[];
}

const {
  audience,
  eyebrow,
  hook,
  subhead,
  leadLabel,
  cta,
  ctaSupport,
  tone,
  valueIntro,
  values,
  credibilityTitle,
  credibility,
  proof,
} = Astro.props;

const isTic = tone === "tic";
const heroBackground = isTic
  ? "linear-gradient(155deg, #061a28 0%, #0a4d7a 58%, #127fb5 100%)"
  : "linear-gradient(155deg, #f8f5ee 0%, #eaf3f7 54%, #d6e7ef 100%)";
const heroText = isTic ? "text-paper" : "text-ink";
const heroMuted = isTic ? "text-on-dark-muted" : "text-ink-muted";
const accent = isTic ? "text-on-dark-accent" : "text-leaf-deep";
---

<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-0 -z-10 pointer-events-none">
    <div
      class="absolute -top-40 -right-28 w-160 h-160 rounded-full opacity-40 blur-3xl drift"
      style="background: radial-gradient(circle, rgba(82,194,230,0.42), transparent 62%);"
    >
    </div>
    <div
      class="absolute top-[34%] -left-40 w-130 h-130 rounded-full opacity-25 blur-3xl"
      style="background: radial-gradient(circle, rgba(0,203,151,0.34), transparent 62%);"
    >
    </div>
  </div>

  <div class="max-w-310 mx-auto px-6 md:px-10 pt-14 md:pt-22 pb-18 md:pb-28">
    <div
      class={`relative overflow-hidden rounded-[38px] px-7 py-10 md:p-14 lg:p-18 ${heroText}`}
      style={`background: ${heroBackground};`}
    >
      <div class="absolute inset-0 contour opacity-35 mix-blend-overlay" aria-hidden="true"></div>
      <div
        aria-hidden="true"
        class="absolute -bottom-28 -right-24 w-100 h-100 rounded-full opacity-35 blur-3xl"
        style="background: radial-gradient(circle, rgba(0,203,151,0.48), transparent 72%);"
      >
      </div>

      <div class="relative grid grid-cols-12 gap-10 items-end">
        <div class="col-span-12 lg:col-span-8">
          <p class={`eyebrow flex items-center gap-3 rise ${isTic ? "text-on-dark-muted" : ""}`}>
            <span class={`w-8 h-px ${isTic ? "bg-on-dark-accent" : "bg-leaf-deep"}`}></span>
            {eyebrow}
          </p>

          <h1
            class="mt-6 font-display text-[2.35rem] sm:text-[3.25rem] md:text-[4.35rem] lg:text-[5.2rem] leading-[0.98] tracking-[-0.04em] rise"
            style="animation-delay: 120ms;"
          >
            {hook}
          </h1>

          <p
            class={`mt-8 max-w-2xl text-[1.08rem] md:text-[1.2rem] leading-[1.65] ${heroMuted} rise`}
            style="animation-delay: 260ms;"
          >
            {subhead}
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4 rise" style="animation-delay: 390ms;">
            <a href="#guia" class="btn btn-primary bg-leaf! text-ink! hover:bg-paper! hover:text-deep!">
              {cta}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a href="#metodo" class={`btn ${isTic ? "border border-white/25 text-paper hover:border-on-dark-accent" : "btn-ghost"}`}>
              Ver método
            </a>
          </div>

          <p class={`mt-5 max-w-xl text-[0.9rem] leading-relaxed ${heroMuted} rise`} style="animation-delay: 500ms;">
            {ctaSupport}
          </p>
        </div>

        <aside class="col-span-12 lg:col-span-4 lg:pl-6 lg:border-l border-white/20 rise" style="animation-delay: 340ms;">
          <p class={`eyebrow ${isTic ? "text-on-dark-muted" : ""}`}>{leadLabel}</p>
          <p class="mt-4 font-display text-[1.45rem] md:text-[1.7rem] leading-[1.3]">
            5 preguntas para conectar con tus
            <span class={`font-display-italic ${accent}`}> valores</span>
            y tomar decisiones con claridad.
          </p>
          <div class="hairline mt-7 opacity-70"></div>
          <ul class={`mt-6 space-y-3 text-[0.94rem] ${heroMuted}`}>
            <li class="tick">15-20 minutos por pregunta</li>
            <li class="tick">Para escribir, no solo pensar</li>
            <li class="tick">Con invitación a sesión de exploración</li>
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

<section id="metodo" class="relative">
  <div class="max-w-310 mx-auto px-6 md:px-10 py-18 md:py-26">
    <div class="grid grid-cols-12 gap-8 items-end reveal">
      <div class="col-span-12 lg:col-span-7">
        <p class="eyebrow flex items-center gap-3">
          <span class="w-8 h-px bg-leaf-deep"></span> Propuesta de valor
        </p>
        <h2 class="mt-4 font-display text-[2.1rem] md:text-[3rem] leading-[1.07] tracking-[-0.03em] text-ink">
          Coaching integrativo para
          <span class="font-display-italic text-deep">{audience}</span>
        </h2>
      </div>
      <p class="col-span-12 lg:col-span-5 text-[1.02rem] text-ink-muted leading-relaxed">
        {valueIntro}
      </p>
    </div>

    <div class="mt-14 grid grid-cols-12 gap-px bg-rule border border-rule rounded-[30px] overflow-hidden">
      {values.map((item, index) => (
        <article
          class="col-span-12 md:col-span-4 bg-paper p-8 md:p-10 min-h-78 flex flex-col reveal hover:bg-mist-soft transition-colors duration-500"
          style={`transition-delay: ${index * 80}ms;`}
        >
          <span class="numeral text-[1.8rem]">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="mt-10 font-display text-[1.55rem] md:text-[1.8rem] leading-[1.12] tracking-[-0.02em] text-ink">
            {item.title}
          </h3>
          <p class="mt-5 text-[0.98rem] leading-[1.65] text-ink-muted">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="sobre" class="relative">
  <div class="max-w-310 mx-auto px-6 md:px-10 py-18 md:py-26">
    <div class="grid grid-cols-12 gap-10 items-start">
      <div class="col-span-12 lg:col-span-5 reveal">
        <div class="rounded-[32px] p-8 md:p-10 border border-rule bg-white/65">
          <p class="eyebrow">Credenciales</p>
          <dl class="mt-8 grid grid-cols-3 gap-4 text-center">
            {proof.map((item) => (
              <div>
                <dt class="eyebrow text-[0.62rem]">{item.label}</dt>
                <dd class="mt-2 font-display text-[1.35rem] md:text-[1.55rem] text-deep">{item.value}</dd>
              </div>
            ))}
          </dl>
          <div class="hairline mt-8"></div>
          <p class="mt-6 text-[0.95rem] leading-[1.65] text-ink-muted">
            Neurociencia, psicología humanista y filosofía práctica aplicadas con una mirada directa, humana y sostenible.
          </p>
        </div>
      </div>

      <div class="col-span-12 lg:col-span-7 reveal" style="transition-delay: 100ms;">
        <p class="eyebrow flex items-center gap-3">
          <span class="w-8 h-px bg-leaf-deep"></span> Por qué escucharme
        </p>
        <h2 class="mt-4 font-display text-[2rem] md:text-[2.85rem] leading-[1.08] tracking-[-0.03em] text-ink">
          {credibilityTitle}
        </h2>
        <div class="mt-8 space-y-5 text-[1.02rem] leading-[1.72] text-ink-muted max-w-2xl">
          {credibility.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>

<section id="guia" class="relative">
  <div class="max-w-310 mx-auto px-6 md:px-10 py-20 md:py-28">
    <div class="relative overflow-hidden rounded-[36px] reveal" style="background: linear-gradient(160deg, #0a4d7a 0%, #082438 70%, #061a28 100%);">
      <div aria-hidden="true" class="absolute -top-32 -right-24 w-115 h-115 rounded-full opacity-50 blur-3xl" style="background: radial-gradient(circle, rgba(0,203,151,0.5), transparent 70%);"></div>
      <div aria-hidden="true" class="absolute inset-0 contour opacity-[0.4] mix-blend-overlay"></div>

      <div class="relative grid grid-cols-12 gap-10 p-8 md:p-14 lg:p-18 text-paper">
        <div class="col-span-12 lg:col-span-7">
          <p class="eyebrow flex items-center gap-3 text-on-dark-accent">
            <span class="w-8 h-px bg-on-dark-accent"></span> Guía gratuita · PDF
          </p>
          <h2 class="mt-5 font-display text-[2rem] md:text-[3.1rem] leading-[1.04] tracking-[-0.03em]">
            5 preguntas para conectar con tus valores y tomar decisiones con claridad.
          </h2>
          <p class="mt-7 text-[1.05rem] leading-[1.7] max-w-136 text-on-dark-muted">
            Esta guía está pensada para profesionales que quieren tomar decisiones alineadas con sus valores, ya sea en su desarrollo personal, en su liderazgo o en la gestión de equipos.
          </p>
          <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-[0.95rem] text-on-dark-muted">
            <li class="flex items-baseline gap-3"><span class="numeral text-[1rem] text-on-dark-accent">01</span> Lo que importa más allá del “debería”</li>
            <li class="flex items-baseline gap-3"><span class="numeral text-[1rem] text-on-dark-accent">02</span> Valores que acercan y valores que evitan</li>
            <li class="flex items-baseline gap-3"><span class="numeral text-[1rem] text-on-dark-accent">03</span> Tu jerarquía actual de valores</li>
            <li class="flex items-baseline gap-3"><span class="numeral text-[1rem] text-on-dark-accent">04</span> Incoherencias entre valores y acciones</li>
            <li class="flex items-baseline gap-3 sm:col-span-2"><span class="numeral text-[1rem] text-on-dark-accent">05</span> El siguiente paso más pequeño y alineado</li>
          </ul>
        </div>

        <div class="col-span-12 lg:col-span-5">
          <form
            class="rounded-3xl p-7 md:p-8 border"
            style="background: rgba(255,255,255,0.06); border-color: rgba(203,220,229,0.2); backdrop-filter: blur(6px);"
            onsubmit="event.preventDefault(); this.querySelector('button').textContent = '✓ Revisa tu correo';"
          >
            <p class="font-display text-[1.2rem]">Recibe tu copia ahora</p>
            <div class="mt-6 space-y-3">
              <label class="block">
                <span class="sr-only">Nombre</span>
                <input type="text" name="nombre" placeholder="Tu nombre (opcional)" class="field" style="background: rgba(255,255,255,0.92); color: var(--color-ink);" />
              </label>
              <label class="block">
                <span class="sr-only">Email</span>
                <input type="email" name="email" required placeholder="tu@correo.com" class="field" style="background: rgba(255,255,255,0.92); color: var(--color-ink);" />
              </label>
              <button type="submit" class="btn btn-primary w-full justify-center bg-leaf! text-ink! hover:bg-leaf-deep! hover:text-paper!">
                {cta}
                <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>
            <p class="mt-5 text-[0.78rem] leading-relaxed text-on-dark-soft">
              Recibirás la guía por email. Después podrás completar, si quieres, un cuestionario breve para orientar mejor una posible sesión de exploración.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
