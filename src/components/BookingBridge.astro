---
/**
 * Intermediate step between a "Reservar" CTA and Microsoft Bookings: says what
 * is being booked and what happens after leaving the site. The default slot
 * holds the "¿Qué estás reservando?" copy.
 */
import { BOOKINGS_SENDER_EMAIL, CONTACT_EMAIL } from "../lib/constants";

interface Props {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  facts: string[];
  bookingUrl: string;
}

const { eyebrow, title, titleAccent, lede, facts, bookingUrl } = Astro.props;

const bookingHost = new URL(bookingUrl).hostname;

const steps = [
  {
    title: "Se abre Microsoft Bookings",
    text: `Al pulsar «Elegir día y hora» se abre en una pestaña nueva la página de Microsoft Bookings (${bookingHost}), la herramienta con la que gestiono mis citas. No necesitas una cuenta de Microsoft.`,
  },
  {
    title: "Eliges día y hora",
    text: "Verás los huecos que tengo libres. Eliges el que te venga bien y dejas tu nombre y tu correo para que pueda contactarte.",
  },
  {
    title: "Te llega la confirmación",
    text: "La reserva se confirma allí mismo y recibes un correo con la fecha, la hora y los detalles de la cita. Si te surge algo, desde ese correo puedes cambiarla o cancelarla.",
  },
];
---

<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-0 -z-10 pointer-events-none">
    <div
      class="absolute -top-28 -right-24 h-120 w-120 rounded-full opacity-30 blur-3xl"
      style="background: radial-gradient(circle at 50% 50%, rgba(82,194,230,0.5), transparent 62%);"
    >
    </div>
    <div
      class="absolute bottom-0 -left-24 h-110 w-110 rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle at 50% 50%, rgba(0,203,151,0.42), transparent 64%);"
    >
    </div>
  </div>

  <div class="max-w-275 mx-auto w-full min-w-0 px-6 md:px-10 py-16 md:py-24">
    <article
      class="relative min-w-0 overflow-hidden rounded-[34px] border border-rule bg-paper-warm/80 p-8 shadow-[0_24px_70px_rgba(10,77,122,0.12)] md:p-12 lg:p-16"
    >
      <div
        aria-hidden="true"
        class="contour absolute inset-0 opacity-[0.28] mix-blend-multiply"
      >
      </div>

      <div class="relative max-w-3xl">
        <p class="eyebrow eyebrow-with-rule">
          <span class="w-8 h-px shrink-0 bg-leaf-deep"></span>
          <span class="min-w-0">{eyebrow}</span>
        </p>

        <h1
          class="mt-5 font-display text-[2.35rem] leading-[1.04] tracking-[-0.035em] text-ink md:text-[4rem]"
        >
          {title}
          <span class="font-display-italic text-deep"> {titleAccent}</span>
        </h1>

        <p
          class="mt-6 max-w-2xl text-[1.05rem] leading-[1.75] text-ink-muted md:text-[1.12rem]"
        >
          {lede}
        </p>

        <div
          class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.85rem] text-ink-soft"
        >
          {facts.map((fact) => <span class="tick">{fact}</span>)}
        </div>

        <div class="mt-9 flex flex-col sm:flex-row">
          <a
            href={bookingUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-primary justify-center"
          >
            Elegir día y hora
            <span class="arrow" aria-hidden="true">→</span>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </div>

        <div
          class="mt-6 max-w-2xl overflow-hidden rounded-2xl border border-rule bg-paper/70 text-[0.92rem] leading-[1.65] text-ink-muted"
        >
          <p class="px-5 py-4">
            <strong class="text-ink">Sigues reservando conmigo.</strong>
            El calendario se abre en una pestaña nueva, en Microsoft Bookings, la
            herramienta con la que gestiono las citas. Eliges día y hora, y la
            reserva se confirma allí mismo.
          </p>
          <p
            class="border-t border-rule border-l-4 border-l-leaf-deep bg-leaf/10 px-5 py-4"
          >
            <strong class="text-ink">Antes de reservar:</strong> agenda mi correo
            en tus contactos para que la confirmación
            <strong class="text-ink">no vaya a spam</strong>.
            <a
              href={`mailto:${BOOKINGS_SENDER_EMAIL}`}
              class="mt-1 block w-fit break-all font-semibold text-deep underline decoration-leaf-deep decoration-1 underline-offset-4 hover:decoration-2"
              >{BOOKINGS_SENDER_EMAIL}</a
            >
          </p>
        </div>
      </div>
    </article>

    <div class="mt-16 md:mt-20 grid min-w-0 gap-14 lg:grid-cols-12 lg:gap-12">
      <section class="min-w-0 lg:col-span-7" aria-labelledby="como-funciona">
        <p class="eyebrow eyebrow-with-rule">
          <span class="w-8 h-px shrink-0 bg-leaf-deep"></span>
          <span class="min-w-0">Cómo funciona</span>
        </p>
        <h2
          id="como-funciona"
          class="mt-4 font-display text-[1.9rem] leading-[1.1] tracking-[-0.03em] text-ink md:text-[2.4rem]"
        >
          Qué pasa al
          <span class="font-display-italic text-deep"> reservar</span>
        </h2>

        <ol class="mt-8 space-y-7">
          {
            steps.map((step, index) => (
              <li class="flex min-w-0 gap-5">
                <span class="numeral text-[1.1rem] leading-[1.6] shrink-0">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0">
                  <h3 class="text-[1.05rem] font-semibold text-ink">
                    {step.title}
                  </h3>
                  <p class="mt-1.5 text-[0.98rem] leading-[1.7] text-ink-muted">
                    {step.text}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <aside class="min-w-0 lg:col-span-5 lg:pl-10 lg:border-l lg:border-rule">
        <section aria-labelledby="que-reservas">
          <h2
            id="que-reservas"
            class="font-display text-[1.6rem] leading-[1.15] tracking-[-0.03em] text-ink"
          >
            ¿Qué estás reservando?
          </h2>
          <div
            class="mt-4 space-y-4 text-[0.98rem] leading-[1.75] text-ink-muted [&_strong]:text-ink"
          >
            <slot />
          </div>
        </section>

        <section class="mt-10" aria-labelledby="dudas">
          <h2
            id="dudas"
            class="font-display text-[1.6rem] leading-[1.15] tracking-[-0.03em] text-ink"
          >
            ¿Dudas?
          </h2>
          <p class="mt-4 text-[0.98rem] leading-[1.75] text-ink-muted">
            Si antes de reservar quieres preguntarme algo, escríbeme a
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="text-deep underline decoration-leaf-deep decoration-1 underline-offset-4 hover:decoration-2"
              >{CONTACT_EMAIL}</a
            >.
          </p>
        </section>
      </aside>
    </div>
  </div>
</section>
