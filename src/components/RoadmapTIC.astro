---
const phases = [
  {
    num: "01",
    title: "Diagnóstico",
    subtitle: "Mapeo inicial (Semanas 1-2)",
    description: "Evaluación inicial de la cultura del equipo, entrevistas individuales confidenciales y análisis de los canales de comunicación y fricciones.",
    items: [
      { text: "Alineación de objetivos con gerencia", iconPath: "M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z M12 6a6 6 0 1 0 0 12 6 6 0 0 0 0-12z M12 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" },
      { text: "Entrevistas individuales de confianza", iconPath: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" },
      { text: "Diagnóstico de dinámicas de equipo", iconPath: "M22 12h-4l-3 9L9 3l-3 9H2" },
    ],
    icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
  },
  {
    num: "02",
    title: "Despliegue",
    subtitle: "Acompañamiento activo (Meses 2-5)",
    description: "Proceso interactivo donde combinamos talleres colectivos del equipo completo con sesiones individuales de soporte.",
    items: [
      { text: "Sesiones grupales de toma de decisiones", iconPath: "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" },
      { text: "Coaching individual para el líder técnico", iconPath: "m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" },
      { text: "Desactivación de silos y fricciones", iconPath: "M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" },
    ],
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    num: "03",
    title: "Sostenibilidad",
    subtitle: "Consolidación (Mes 6)",
    description: "Cierre del programa con acuerdos firmes de comunicación, métricas de fricción reducidas y un plan de seguimiento.",
    items: [
      { text: "Establecimiento de acuerdos de comunicación", iconPath: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8" },
      { text: "Evaluación final de avances y KPI", iconPath: "M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6" },
      { text: "Sesión de seguimiento a los 3 meses", iconPath: "M12 8v4l3 3 M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" },
    ],
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];
---

<div class="roadmap-container mt-16 md:mt-20 border border-white/10 rounded-[28px] overflow-hidden shadow-xl">
  {phases.map((phase, idx) => (
    <article 
      class="roadmap-card min-w-0 p-8 md:p-10 reveal"
      style={`transition-delay: ${idx * 80}ms;`}
    >
      <!-- Top Row: Numeral and Icon -->
      <div class="flex min-w-0 items-center justify-between">
        <span class="numeral text-[1.8rem] text-on-dark-accent!">{phase.num}</span>
        <svg 
          width="48" 
          height="32" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.4" 
          stroke-linecap="round" 
          stroke-linejoin="round"
          class="text-sky opacity-80"
          aria-hidden="true"
        >
          <path d={phase.icon} />
        </svg>
      </div>

      <!-- Phase Title & Subtitle -->
      <h3 class="mt-12 md:mt-16 font-display text-[1.45rem] md:text-[1.65rem] leading-[1.1] tracking-[-0.02em] text-paper">
        {phase.title}
        <span class="block font-display-italic text-on-dark-accent text-[0.95rem] mt-2 tracking-normal">
          {phase.subtitle}
        </span>
      </h3>

      <!-- Description -->
      <p class="mt-5 text-[0.98rem] leading-[1.65] text-on-dark-soft">
        {phase.description}
      </p>

      <!-- Bullet List -->
      <div class="h-px bg-white/10 mt-6"></div>
      <ul class="mt-5 space-y-3 text-[0.88rem] text-on-dark-muted">
        {phase.items.map((item) => (
          <li class="flex items-start gap-3 leading-snug">
            <svg 
              width="15" 
              height="15" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="1.8" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-on-dark-accent"
              aria-hidden="true"
            >
              <path d={item.iconPath} />
            </svg>
            <span class="min-w-0">{item.text}</span>
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>

<style>
  .roadmap-container {
    display: grid;
    grid-template-columns: 1fr;
    background-image: linear-gradient(180deg, #0a4d7a 0%, #065e91 52%, #061a28 100%);
    background-size: 100% 100%;
  }

  article {
    display: flex;
    flex-direction: column;
    background: rgba(0, 0, 0, 0);
    transition: background 400ms ease, transform 400ms ease, opacity 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Hover card lights up by dimming the background slightly to black 20% for improved text contrast */
  article:hover {
    background: rgba(0, 0, 0, 0.2);
  }

  /* Separate cards with borders on mobile */
  article:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .roadmap-container {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto auto auto auto auto;
      background-image: linear-gradient(90deg, #0a4d7a 0%, #065e91 52%, #061a28 100%);
      background-size: 100% 100%;
    }

    article {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      background: rgba(0, 0, 0, 0);
    }

    article:hover {
      background: rgba(0, 0, 0, 0.2);
    }

    /* Reset mobile borders and apply horizontal borders for desktop grid */
    article:not(:last-child) {
      border-bottom: none;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  .tick-dark {
    position: relative;
    padding-left: 1.4rem;
  }
  .tick-dark::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.7rem;
    height: 1px;
    background: var(--color-on-dark-accent);
  }
</style>

