---
import LeafMark from "./LeafMark.astro";

const year = new Date().getFullYear();
---

<footer class="relative">
  <div
    class="border-t border-[color:var(--color-rule)]/70"
    style="background: linear-gradient(180deg, rgba(244,247,249,0) 0%, rgba(232,241,246,0.6) 100%);"
  >
    <div class="max-w-[1240px] mx-auto px-6 md:px-10 pt-16 pb-10">
      <div class="grid grid-cols-12 gap-10">
        <!-- Brand -->
        <div class="col-span-12 md:col-span-5">
          <a href="/" class="flex items-center gap-3">
            <LeafMark size={32} />
            <span
              class="font-display text-[1.6rem] tracking-[-0.02em] text-[color:var(--color-ink)]"
              style="font-variation-settings: 'opsz' 144, 'SOFT' 50;"
            >
              Virtus<span class="font-display-italic text-[color:var(--color-deep)]">way</span>
            </span>
          </a>
          <p class="mt-5 max-w-md text-[0.96rem] leading-[1.65] text-[color:var(--color-ink-muted)]">
            Coaching integrativo para liderar con coherencia y claridad.
            Trabajo online desde Valencia con personas y equipos en
            <em class="font-display-italic">español e inglés</em>.
          </p>
        </div>

        <!-- Navigation -->
        <div class="col-span-6 md:col-span-3">
          <p class="eyebrow">Sitio</p>
          <ul class="mt-4 space-y-2.5 text-[0.95rem]">
            <li><a href="#audiencia" class="hover:text-[color:var(--color-deep)] transition-colors">Acompañamiento</a></li>
            <li><a href="#metodo" class="hover:text-[color:var(--color-deep)] transition-colors">Método</a></li>
            <li><a href="#sobre" class="hover:text-[color:var(--color-deep)] transition-colors">Sobre mí</a></li>
            <li><a href="#guia" class="hover:text-[color:var(--color-deep)] transition-colors">Guía gratuita</a></li>
            <li><a href="#contacto" class="hover:text-[color:var(--color-deep)] transition-colors">Contacto</a></li>
          </ul>
        </div>

        <!-- Legal -->
        <div class="col-span-6 md:col-span-4">
          <p class="eyebrow">Legal &amp; ética</p>
          <ul class="mt-4 space-y-2.5 text-[0.95rem]">
            <li><a href="/legal/aviso-legal" class="hover:text-[color:var(--color-deep)] transition-colors">Aviso legal</a></li>
            <li><a href="/legal/politica-privacidad" class="hover:text-[color:var(--color-deep)] transition-colors">Política de privacidad</a></li>
            <li><a href="/legal/politica-cookies" class="hover:text-[color:var(--color-deep)] transition-colors">Política de cookies</a></li>
            <li><a href="/legal/compromiso-etico" class="hover:text-[color:var(--color-deep)] transition-colors">Compromiso ético · EMCC</a></li>
          </ul>
          <p class="mt-6 text-[0.85rem] text-[color:var(--color-ink-soft)]">
            coach@virtusway.com · Valencia, España
          </p>
        </div>
      </div>

      <div class="hairline mt-14"></div>

      <div
        class="mt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-[0.82rem] text-[color:var(--color-ink-soft)]"
      >
        <p>© {year} VirtusWay · Mauricio Magni Manchón. Todos los derechos reservados.</p>
        <p class="font-display-italic">Hecho con presencia en Valencia.</p>
      </div>
    </div>
  </div>
</footer>
