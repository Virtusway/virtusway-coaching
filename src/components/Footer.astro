---
import { CONTACT_EMAIL, SOCIAL_URLS, TALK_PATH, WHATSAPP_CHANNEL_URL } from "../lib/constants";

const year = new Date().getFullYear();
---

<footer class="relative">
  <div
    class="border-t border-rule/70"
    style="
      background: linear-gradient(180deg, rgba(244, 247, 249, 0) 0%, rgba(232, 241, 246, 0.6) 100%);
    "
  >
    <div class="max-w-310 mx-auto w-full min-w-0 px-6 md:px-10 pt-16 pb-10">
      <div class="grid min-w-0 grid-cols-1 gap-10 md:grid-cols-12 md:gap-x-10 md:gap-y-10">
        <!-- Brand -->
        <div class="min-w-0 md:col-span-5">
          <a href="/" class="flex items-center gap-3 group">
            <img
              src="/brand/WEB/Virtusway_Brand_H.svg"
              alt="VirtusWay"
              width="201"
              height="33"
              class="h-9 w-auto opacity-95 group-hover:opacity-100 transition-opacity"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="mt-5 max-w-md text-[0.96rem] leading-[1.65] text-ink-muted">
            VirtusWay es coaching integrativo para mujeres profesionales y
            <strong class="text-ink">líderes de equipos TIC</strong>. Una mirada práctica y humana,
            sin recetas prefabricadas.
          </p>

          <p class="mt-6 eyebrow">Sígueme</p>
          <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.92rem]">
            <li>
              <a
                href={SOCIAL_URLS.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-deep underline decoration-leaf-deep/40 underline-offset-4 hover:decoration-leaf-deep"
                >LinkedIn</a
              >
            </li>
            <li>
              <a
                href={SOCIAL_URLS.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="text-deep underline decoration-leaf-deep/40 underline-offset-4 hover:decoration-leaf-deep"
                >Instagram</a
              >
            </li>
            <li>
              <a
                href={WHATSAPP_CHANNEL_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-deep underline decoration-leaf-deep/40 underline-offset-4 hover:decoration-leaf-deep"
                >Canal de WhatsApp</a
              >
            </li>
          </ul>
        </div>

        <!-- Navigation -->
        <div class="min-w-0 md:col-span-3">
          <p class="eyebrow">Sitio</p>
          <ul class="mt-4 space-y-2.5 text-[0.95rem]">
            <li>
              <a href="/" class="hover:text-deep transition-colors">Inicio</a>
            </li>
            <li>
              <a href="/mujeres-profesionales" class="hover:text-deep transition-colors"
                >Mujeres profesionales</a
              >
            </li>
            <li>
              <a href="/equipos-tic" class="hover:text-deep transition-colors">Equipos TIC</a>
            </li>
            <li>
              <a href="/#guia" class="hover:text-deep transition-colors">Guía gratuita</a>
            </li>
            <li>
              <a href={TALK_PATH} class="hover:text-deep transition-colors">Hablemos</a>
            </li>
          </ul>
        </div>

        <!-- Legal -->
        <div class="min-w-0 md:col-span-4">
          <p class="eyebrow">Legal &amp; ética</p>
          <ul class="mt-4 space-y-2.5 text-[0.95rem]">
            <li>
              <a href="/legal/aviso-legal" class="hover:text-deep transition-colors">Aviso legal</a>
            </li>
            <li>
              <a href="/legal/politica-privacidad" class="hover:text-deep transition-colors"
                >Política de privacidad</a
              >
            </li>
            <li>
              <a href="/legal/politica-cookies" class="hover:text-deep transition-colors"
                >Política de cookies</a
              >
            </li>
            <li>
              <a href="/legal/compromiso-etico" class="hover:text-deep transition-colors"
                >Compromiso ético · Código EMCC</a
              >
            </li>
            <li>
              <a href="/revocar-consentimiento" class="hover:text-deep transition-colors"
                >Revocar consentimiento</a
              >
            </li>
          </ul>
          <p class="mt-6 text-[0.85rem] text-ink-soft">{CONTACT_EMAIL} · Valencia, España</p>
        </div>
      </div>

      <div class="hairline mt-14"></div>

      <div
        class="mt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-[0.82rem] text-ink-soft"
      >
        <p>© {year} VirtusWay · Mauricio Magni Manchón. Todos los derechos reservados.</p>
        <p class="font-display-italic">VirtusWay® es marca registrada</p>
      </div>
    </div>
  </div>
</footer>
