---
// Client Feedback / Approval Widget for preview environments.
// Displays a checklist of specific changes made in Phase 2 with "Go to" scroll buttons.
---

<div id="feedback-widget-container" class="hidden">
  <!-- Trigger Button -->
  <button
    id="feedback-trigger-btn"
    class="fixed bottom-6 right-6 z-[100] flex items-center gap-2.5 bg-ink text-paper px-4.5 py-3.5 rounded-full shadow-xl hover:bg-deep hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer border border-white/10"
    aria-label="Abrir checklist de revisión"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-dark-accent">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span class="font-sans text-[0.88rem] font-semibold tracking-wide">Aprobar Cambios</span>
  </button>

  <!-- Feedback Panel -->
  <div
    id="feedback-panel"
    class="fixed bottom-24 right-6 z-[100] w-96 max-w-[calc(100vw-3rem)] bg-paper border border-rule rounded-[22px] shadow-2xl p-6 flex flex-col gap-4 transition-all duration-300 scale-95 opacity-0 pointer-events-none origin-bottom-right max-h-[calc(100vh-8rem)] overflow-y-auto"
    style="background: rgba(255, 255, 255, 0.97); backdrop-filter: blur(8px);"
  >
    <!-- Header -->
    <div class="flex min-w-0 items-center justify-between">
      <div class="min-w-0">
        <h4 class="font-display text-[1.15rem] font-semibold text-ink">Revisión de Cambios</h4>
        <p class="text-[0.75rem] text-ink-muted mt-0.5">Fase 2: Marca la casilla si estás conforme con cada punto</p>
      </div>
      <button
        id="feedback-close-btn"
        class="text-ink-muted hover:text-ink hover:bg-mist-soft p-1.5 rounded-full transition-colors cursor-pointer"
        aria-label="Cerrar panel"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="hairline"></div>

    <!-- Feedback Checklist Form -->
    <form id="feedback-submit-form" class="flex flex-col gap-4">
      
      <!-- Interactive Checklist -->
      <div class="flex flex-col gap-3.5" id="checklist-container">
        <!-- Item templates rendered dynamically by JS depending on page context -->
      </div>

      <div class="hairline"></div>

      <!-- General Comments -->
      <div>
        <label for="feedback-comment" class="block text-[0.82rem] font-semibold text-ink mb-1.5">Comentarios o Notas Generales</label>
        <textarea
          id="feedback-comment"
          name="comment"
          rows="3"
          placeholder="Si tienes alguna sugerencia o cambio sobre los puntos anteriores, escríbelo aquí..."
          class="w-full rounded-xl border border-rule bg-white p-3 text-[0.85rem] leading-relaxed text-ink placeholder:text-ink-muted/50 focus:border-deep/50 focus:outline-none focus:ring-2 focus:ring-deep/20 transition-all resize-none"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="feedback-submit-btn"
        class="w-full justify-center py-3 bg-ink text-paper rounded-xl text-[0.88rem] font-semibold hover:bg-deep transition-colors cursor-pointer flex items-center gap-2"
      >
        <span id="feedback-btn-label">Enviar mi aprobación</span>
        <span class="arrow">→</span>
      </button>

      <!-- Status Info -->
      <p id="feedback-form-status" class="text-[0.82rem] leading-relaxed text-center hidden" role="status"></p>
    </form>
  </div>

  <!-- Flow Diagram Popup Modal -->
  <div
    id="flow-modal"
    class="fixed inset-0 z-[200] bg-ink/60 backdrop-blur-xs flex items-center justify-center p-4 hidden"
  >
    <div class="bg-paper rounded-3xl border border-rule w-full max-w-lg p-6 flex flex-col gap-4 max-h-[90vh] overflow-y-auto shadow-2xl">
      <div class="flex items-center justify-between">
        <div class="min-w-0">
          <h5 class="font-display text-[1.12rem] font-semibold text-ink">Ciclo de Funcionamiento (Contacto)</h5>
          <p class="text-[0.72rem] text-ink-muted mt-0.5">Validaciones y flujos del formulario interactivo</p>
        </div>
        <button
          type="button"
          id="close-flow-modal"
          class="text-ink-muted hover:text-ink cursor-pointer p-1.5 rounded-full hover:bg-mist-soft"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="hairline"></div>
      
      <!-- Flow Steps -->
      <div class="flex flex-col gap-4 text-[0.82rem] leading-relaxed text-ink-muted">
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-on-dark-accent/15 text-on-dark-accent flex items-center justify-center font-bold text-[0.75rem]">1</span>
          <div>
            <p class="font-semibold text-ink">Paso 1: Elección de Interés (Progreso 35%)</p>
            <p>El usuario selecciona su desafío principal para personalizar el recurso, lo cual reduce la fatiga mental y activa el Efecto IKEA.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-on-dark-accent/15 text-on-dark-accent flex items-center justify-center font-bold text-[0.75rem]">2</span>
          <div>
            <p class="font-semibold text-ink">Paso 2: Datos de Contacto (Progreso 75%)</p>
            <p>Se autodefine el email y se requiere el consentimiento. El botón verde de descarga permanece deshabilitado hasta que se ingrese un email válido y se marque el checkbox legal.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-on-dark-accent/15 text-on-dark-accent flex items-center justify-center font-bold text-[0.75rem]">3</span>
          <div>
            <p class="font-semibold text-ink">Procesamiento y Envío (Servidor)</p>
            <p>Al hacer clic se deshabilitan los campos. El servidor registra la opción elegida en la base de datos de Neon y dispara un correo SMTP con la descarga.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-leaf-deep/15 text-leaf-deep flex items-center justify-center font-bold text-[0.75rem]">✔</span>
          <div>
            <p class="font-semibold text-ink">Estado de Éxito (Progreso 100%)</p>
            <p>Se muestra un <strong>toast verde</strong> de éxito. El formulario se resetea y vuelve de forma limpia al Paso 1 para quedar listo para otro uso.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <span class="shrink-0 w-6 h-6 rounded-full bg-red-100 text-red-600 flex items-center justify-center font-bold text-[0.75rem]">⚠</span>
          <div>
            <p class="font-semibold text-ink">Estado de Error (Controlado)</p>
            <p>Se muestra un <strong>toast rojo</strong> con el error exacto (ej. email inválido, base de datos desconectada) y el usuario permanece en el Paso 2 para poder corregirlo.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    // Only display widget in preview environments
    const host = window.location.hostname;
    const isPreview = host.includes("netlify.app") || host === "localhost" || host === "127.0.0.1";

    if (!isPreview) {
      return;
    }

    const container = document.getElementById("feedback-widget-container");
    if (container) {
      container.classList.remove("hidden");
    }

    const triggerBtn = document.getElementById("feedback-trigger-btn");
    const panel = document.getElementById("feedback-panel");
    const closeBtn = document.getElementById("feedback-close-btn");
    const form = document.getElementById("feedback-submit-form");
    const commentArea = document.getElementById("feedback-comment");
    const submitBtn = document.getElementById("feedback-submit-btn");
    const btnLabel = document.getElementById("feedback-btn-label");
    const formStatus = document.getElementById("feedback-form-status");
    const checklistContainer = document.getElementById("checklist-container");

    const flowModal = document.getElementById("flow-modal");
    const closeFlowModalBtn = document.getElementById("close-flow-modal");

    if (!triggerBtn || !panel || !closeBtn || !form || !commentArea || !submitBtn || !btnLabel || !formStatus || !checklistContainer || !flowModal || !closeFlowModalBtn) {
      return;
    }

    // Detección de página
    const isHomePage = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1" 
      ? (window.location.pathname === "/" || window.location.pathname.endsWith("/index.html"))
      : (!window.location.pathname.includes("mujeres-profesionales") && !window.location.pathname.includes("equipos-tic"));
    const isServicesPage = window.location.pathname.includes("mujeres-profesionales") || window.location.pathname.includes("equipos-tic");

    // List of specific changes to review, mapping exactly to our Task list
    const reviewItems = [
      {
        id: "hero-quote",
        title: "Cita y Redundancia (Home)",
        desc: "Eliminamos duplicidad en cabecera lateral cambiando 'Dos caminos. Una misma brújula' por tu mantra oficial: 'De la tecnología a las personas...'.",
        selector: "blockquote",
        page: "home",
        actionText: "Ver"
      },
      {
        id: "lead-magnet-form",
        title: "P1: Formulario Interactivo",
        desc: "Personalización en 2 pasos según interés, barra de progreso y alineación de listas sin palabras huérfanas.",
        selector: "form[data-lead-magnet-form]",
        page: "home",
        actionText: "Ver Form"
      },
      {
        id: "flow-schema",
        title: "P1: Esquema de Funcionamiento",
        desc: "Diagrama y ciclo completo del formulario de contacto (validaciones, base de datos y envío de correos).",
        selector: null,
        page: "home",
        actionText: "Esquema"
      },
      {
        id: "faq-section",
        title: "P2: FAQs de Servicios",
        desc: "Sección de acordeón interactivo de dudas con animación CSS fluida de apertura/cierre sin usar Javascript.",
        selector: "details",
        page: "services",
        actionText: "Ver FAQs"
      },
      {
        id: "p3-iconography-hero",
        title: "P3: Iconografía de Héroe (Servicios)",
        desc: "Sustitución de guiones por iconos vectoriales SVG en la cabecera (incluyendo la sesión de exploración/diagnóstico).",
        selector: "aside ul",
        page: "services",
        actionText: "Ver Iconos"
      },
      {
        id: "p3-iconography-roadmap",
        title: "P3: Iconografía de Roadmap (TIC)",
        desc: "Iconos vectoriales en la parte inferior para cada fase del Roadmap de Equipos TIC (incluyendo Diagnóstico).",
        selector: ".roadmap-container",
        page: "services",
        actionText: "Ver Roadmap"
      },
      {
        id: "p4-geo-seo",
        title: "P4: Optimización Geo-SEO",
        desc: "Esquemas Service (JSON-LD) y copys híbridos para Valencia, Barcelona y Madrid, mejorando el posicionamiento local.",
        selector: "main",
        page: "services",
        actionText: "Ver"
      },
      {
        id: "p5-testimonials",
        title: "P5: Testimonios",
        desc: "Rejilla de opiniones de clientes en Madrid, Valencia y el distrito tecnológico 22@ Barcelona.",
        selector: "#testimonios",
        page: "any",
        actionText: "Ver"
      }
    ];

    // Filter and render items present on the current page
    const activeItems = [];
    reviewItems.forEach((item) => {
      // 1. Filter by page context
      if (item.page === "home" && !isHomePage) return;
      if (item.page === "services" && !isServicesPage) return;

      // 2. Filter by selector presence (if selector is defined)
      const element = item.selector ? document.querySelector(item.selector) : true;
      if (element) {
        activeItems.push(item);

        // Render checklist item html
        const itemEl = document.createElement("div");
        itemEl.className = "flex min-w-0 items-start justify-between gap-3 p-3 rounded-xl border border-rule bg-white/40 hover:bg-white transition-colors";
        itemEl.innerHTML = `
          <label class="flex min-w-0 cursor-pointer items-start gap-2.5 flex-1">
            <input 
              type="checkbox" 
              data-item-id="${item.id}" 
              checked 
              class="mt-1 h-4 w-4 shrink-0 rounded border-rule text-leaf accent-leaf cursor-pointer"
            />
            <div class="min-w-0">
              <p class="text-[0.85rem] font-semibold text-ink leading-tight">${item.title}</p>
              <p class="text-[0.72rem] text-ink-muted leading-snug mt-0.5">${item.desc}</p>
            </div>
          </label>
          <button 
            type="button" 
            data-action-id="${item.id}"
            class="shrink-0 text-[0.72rem] font-semibold text-on-dark-accent bg-leaf-deep/10 px-2 py-1 rounded hover:bg-leaf-deep/20 transition-all cursor-pointer"
          >
            ${item.actionText}
          </button>
        `;
        checklistContainer.appendChild(itemEl);
      }
    });

    // Handle button actions (scroll to element or open flow schema modal)
    activeItems.forEach((item) => {
      const btn = checklistContainer.querySelector(`[data-action-id="${item.id}"]`);
      if (btn) {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          if (item.id === "flow-schema") {
            // Open flow modal
            flowModal.classList.remove("hidden");
          } else if (item.selector) {
            // Scroll to selector
            const element = document.querySelector(item.selector);
            if (element) {
              element.scrollIntoView({ behavior: "smooth", block: "center" });
              
              // Micro animation highlight outline
              element.style.outline = "2px dashed var(--color-leaf)";
              element.style.outlineOffset = "4px";
              setTimeout(() => {
                element.style.outline = "";
                element.style.outlineOffset = "";
              }, 1500);
            }
          }
        });
      }
    });

    // Close flow modal
    closeFlowModalBtn.addEventListener("click", () => {
      flowModal.classList.add("hidden");
    });
    flowModal.addEventListener("click", (e) => {
      if (e.target === flowModal) {
        flowModal.classList.add("hidden");
      }
    });

    // Toggle Panel Open/Close
    let isOpen = false;
    const togglePanel = () => {
      isOpen = !isOpen;
      if (isOpen) {
        panel.classList.remove("pointer-events-none", "scale-95", "opacity-0");
        panel.classList.add("scale-100", "opacity-100");
        triggerBtn.classList.add("scale-90", "opacity-50");
      } else {
        panel.classList.remove("scale-100", "opacity-100");
        panel.classList.add("pointer-events-none", "scale-95", "opacity-0");
        triggerBtn.classList.remove("scale-90", "opacity-50");
      }
    };

    triggerBtn.addEventListener("click", togglePanel);
    closeBtn.addEventListener("click", togglePanel);

    // Form Submission
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const generalComment = commentArea.value.trim();
      
      // Collect checklist results
      const results = [];
      activeItems.forEach((item) => {
        const checkbox = checklistContainer.querySelector(`[data-item-id="${item.id}"]`);
        const checked = checkbox ? checkbox.checked : false;
        results.push(`- [${checked ? "OK" : "REVISAR"}] ${item.title}`);
      });

      const fullComment = 
        `RESULTADOS DE LA REVISIÓN:\n` +
        results.join("\n") + "\n\n" +
        `OBSERVACIONES ADICIONALES:\n` +
        (generalComment || "Sin comentarios adicionales.");

      // Calculate global status based on checks
      const allApproved = results.every(r => r.includes("[OK]"));
      const globalStatus = allApproved ? "approved" : "changes_requested";

      // Start Loading
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-50", "cursor-not-allowed");
      btnLabel.textContent = "Enviando...";
      formStatus.classList.remove("hidden", "text-red-500", "text-leaf-deep");
      formStatus.classList.add("text-ink-muted");
      formStatus.textContent = "Enviando opiniones a Andrés...";

      try {
        const response = await fetch("/api/feedback", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ status: globalStatus, comment: fullComment })
        });

        const payload = await response.json().catch(() => null);
        const message = payload && typeof payload.message === "string" 
          ? payload.message 
          : "Revisión registrada con éxito.";

        if (!response.ok) {
          throw new Error(message);
        }

        // Success State
        formStatus.classList.remove("text-ink-muted");
        formStatus.classList.add("text-leaf-deep", "font-medium");
        formStatus.textContent = message;

        form.reset();
        
        // Reset checklist checks
        checklistContainer.querySelectorAll("input[type='checkbox']").forEach(cb => cb.checked = true);

        // Close after a delay
        setTimeout(() => {
          togglePanel();
          formStatus.classList.add("hidden");
          formStatus.textContent = "";
        }, 3000);

      } catch (error) {
        // Error State
        formStatus.classList.remove("text-ink-muted");
        formStatus.classList.add("text-red-600", "font-medium");
        formStatus.textContent = error instanceof Error ? error.message : "Error al enviar la revisión.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        btnLabel.textContent = "Enviar mi aprobación";
      }
    });
  })();
</script>
