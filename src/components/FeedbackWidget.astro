---
// Client Feedback / Approval Widget for preview environments.
// It will only render on preview hosts (Netlify deploy previews and localhost).
---

<div id="feedback-widget-container" class="hidden">
  <!-- Trigger Button -->
  <button
    id="feedback-trigger-btn"
    class="fixed bottom-6 right-6 z-[100] flex items-center gap-2.5 bg-ink text-paper px-4.5 py-3.5 rounded-full shadow-xl hover:bg-deep hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer border border-white/10"
    aria-label="Abrir panel de feedback"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-on-dark-accent">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="font-sans text-[0.88rem] font-semibold tracking-wide">Revisión Fase 2</span>
  </button>

  <!-- Feedback Panel -->
  <div
    id="feedback-panel"
    class="fixed bottom-24 right-6 z-[100] w-88 max-w-[calc(100vw-3rem)] bg-paper border border-rule rounded-[22px] shadow-2xl p-6 flex flex-col gap-4 transition-all duration-300 scale-95 opacity-0 pointer-events-none origin-bottom-right"
    style="background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(8px);"
  >
    <!-- Header -->
    <div class="flex min-w-0 items-center justify-between">
      <div class="min-w-0">
        <h4 class="font-display text-[1.12rem] font-semibold text-ink">Panel de Aprobación</h4>
        <p class="text-[0.75rem] text-ink-muted mt-0.5">Envía tus comentarios directamente a Andrés</p>
      </div>
      <button
        id="feedback-close-btn"
        class="text-ink-muted hover:text-ink hover:bg-mist-soft p-1.5 rounded-full transition-colors cursor-pointer"
        aria-label="Cerrar panel"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="hairline"></div>

    <!-- Feedback Form -->
    <form id="feedback-submit-form" class="flex flex-col gap-4">
      <!-- Status Selection -->
      <div>
        <label class="block text-[0.82rem] font-semibold text-ink mb-2">¿Cómo ves los cambios?</label>
        <div class="grid grid-cols-2 gap-2.5">
          <button
            type="button"
            data-status-val="approved"
            class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-rule bg-white text-[0.82rem] font-semibold text-ink hover:border-leaf/40 transition-all cursor-pointer"
          >
            <span class="text-leaf">✔</span> Aprobar (OK)
          </button>
          <button
            type="button"
            data-status-val="changes_requested"
            class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-rule bg-white text-[0.82rem] font-semibold text-ink hover:border-red-400 transition-all cursor-pointer"
          >
            <span class="text-red-500">⚠</span> Observaciones
          </button>
        </div>
        <input type="hidden" name="status" id="feedback-status-input" value="approved" />
      </div>

      <!-- Comment Textarea -->
      <div>
        <label for="feedback-comment" class="block text-[0.82rem] font-semibold text-ink mb-2">Comentarios y Observaciones</label>
        <textarea
          id="feedback-comment"
          name="comment"
          required
          rows="4"
          placeholder="Escribe aquí las correcciones que consideres necesarias, o tu aprobación..."
          class="w-full rounded-xl border border-rule bg-white p-3 text-[0.85rem] leading-relaxed text-ink placeholder:text-ink-muted/60 focus:border-deep/50 focus:outline-none focus:ring-2 focus:ring-deep/20 transition-all resize-none"
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="feedback-submit-btn"
        class="w-full justify-center py-3 bg-ink text-paper rounded-xl text-[0.88rem] font-semibold hover:bg-deep transition-colors cursor-pointer flex items-center gap-2"
      >
        <span id="feedback-btn-label">Enviar a Andrés</span>
        <span class="arrow">→</span>
      </button>

      <!-- Status Info -->
      <p id="feedback-form-status" class="text-[0.82rem] leading-relaxed text-center hidden" role="status"></p>
    </form>
  </div>
</div>

<style>
  /* Selected button styles */
  .btn-selected-approved {
    border-color: var(--color-leaf) !important;
    background-color: rgba(0, 203, 151, 0.08) !important;
    color: var(--color-leaf-deep) !important;
    box-shadow: 0 0 0 1px var(--color-leaf);
  }
  .btn-selected-changes {
    border-color: #f87171 !important;
    background-color: rgba(239, 68, 68, 0.08) !important;
    color: #b91c1c !important;
    box-shadow: 0 0 0 1px #f87171;
  }
</style>

<script is:inline>
  (function () {
    // Only display widget in preview environments
    const host = window.location.hostname;
    const isPreview = host.includes("netlify.app") || host === "localhost" || host === "127.0.0.1";

    if (!isPreview) {
      return;
    }

    const container = document.getElementById("feedback-widget-container");
    if (container) {
      container.classList.remove("hidden");
    }

    const triggerBtn = document.getElementById("feedback-trigger-btn");
    const panel = document.getElementById("feedback-panel");
    const closeBtn = document.getElementById("feedback-close-btn");
    const form = document.getElementById("feedback-submit-form");
    const statusInput = document.getElementById("feedback-status-input");
    const commentArea = document.getElementById("feedback-comment");
    const submitBtn = document.getElementById("feedback-submit-btn");
    const btnLabel = document.getElementById("feedback-btn-label");
    const formStatus = document.getElementById("feedback-form-status");

    const statusButtons = {
      approved: document.querySelector('[data-status-val="approved"]'),
      changes_requested: document.querySelector('[data-status-val="changes_requested"]')
    };

    if (!triggerBtn || !panel || !closeBtn || !form || !statusInput || !commentArea || !submitBtn || !btnLabel || !formStatus) {
      return;
    }

    // Toggle Panel
    let isOpen = false;
    const togglePanel = () => {
      isOpen = !isOpen;
      if (isOpen) {
        panel.classList.remove("pointer-events-none", "scale-95", "opacity-0");
        panel.classList.add("scale-100", "opacity-100");
        triggerBtn.classList.add("scale-90", "opacity-50");
        commentArea.focus();
      } else {
        panel.classList.remove("scale-100", "opacity-100");
        panel.classList.add("pointer-events-none", "scale-95", "opacity-0");
        triggerBtn.classList.remove("scale-90", "opacity-50");
      }
    };

    triggerBtn.addEventListener("click", togglePanel);
    closeBtn.addEventListener("click", togglePanel);

    // Status Selectors
    const setStatusVal = (val) => {
      statusInput.value = val;
      if (val === "approved") {
        statusButtons.approved.classList.add("btn-selected-approved");
        statusButtons.changes_requested.classList.remove("btn-selected-changes");
        commentArea.placeholder = "Escribe un comentario o validación si lo deseas (opcional)...";
        commentArea.required = false;
      } else {
        statusButtons.approved.classList.remove("btn-selected-approved");
        statusButtons.changes_requested.classList.add("btn-selected-changes");
        commentArea.placeholder = "Por favor detalla qué cambios, textos o secciones consideras oportuno modificar...";
        commentArea.required = true;
      }
    };

    // Set initial
    setStatusVal("approved");

    statusButtons.approved.addEventListener("click", () => setStatusVal("approved"));
    statusButtons.changes_requested.addEventListener("click", () => setStatusVal("changes_requested"));

    // Form Submission
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const status = statusInput.value;
      const comment = commentArea.value.trim();

      if (status === "changes_requested" && !comment) {
        commentArea.focus();
        return;
      }

      // Start Loading
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-50", "cursor-not-allowed");
      btnLabel.textContent = "Enviando...";
      formStatus.classList.remove("hidden", "text-red-500", "text-leaf-deep");
      formStatus.classList.add("text-ink-muted");
      formStatus.textContent = "Enviando opinión a Andrés...";

      try {
        const response = await fetch("/api/feedback", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ status, comment: comment || "Aprobado (sin comentarios adicionales)." })
        });

        const payload = await response.json().catch(() => null);
        const message = payload && typeof payload.message === "string" 
          ? payload.message 
          : "Opinión registrada con éxito.";

        if (!response.ok) {
          throw new Error(message);
        }

        // Success State
        formStatus.classList.remove("text-ink-muted");
        formStatus.classList.add("text-leaf-deep", "font-medium");
        formStatus.textContent = message;

        form.reset();
        setStatusVal("approved");

        // Close after a delay
        setTimeout(() => {
          togglePanel();
          formStatus.classList.add("hidden");
          formStatus.textContent = "";
        }, 3000);

      } catch (error) {
        // Error State
        formStatus.classList.remove("text-ink-muted");
        formStatus.classList.add("text-red-600", "font-medium");
        formStatus.textContent = error instanceof Error ? error.message : "Error al enviar el feedback.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        btnLabel.textContent = "Enviar a Andrés";
      }
    });
  })();
</script>
