---
import LeafMark from "./LeafMark.astro";
---

<header class="sticky top-0 z-40">
  <div class="backdrop-blur-md bg-paper/75 border-b border-rule/70">
    <div
      class="max-w-310 mx-auto px-6 md:px-10 flex items-center justify-between h-18 gap-6"
    >
      <a
        href="/"
        class="flex items-center gap-3 group"
        aria-label="VirtusWay — inicio"
      >
        <LeafMark
          size={26}
          class="transition-transform duration-500 group-hover:-rotate-6"
        />
        <span class="flex items-baseline gap-2">
          <span
            class="font-display text-[1.35rem] tracking-[-0.02em] text-ink"
            style="font-variation-settings: 'opsz' 144, 'SOFT' 50;"
          >
            Virtus<span class="font-display-italic text-deep">way</span>
          </span>
          <span
            class="hidden sm:inline text-[0.65rem] tracking-eyebrow uppercase text-ink-soft font-medium"
          >
            coaching integrativo
          </span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-9 text-[0.92rem] text-ink">
        <a href="#audiencia" class="hover:text-deep transition-colors"
          >Acompañamiento</a
        >
        <a href="#metodo" class="hover:text-deep transition-colors">Método</a>
        <a href="#sobre" class="hover:text-deep transition-colors">Sobre mí</a>
        <a href="#contacto" class="hover:text-deep transition-colors"
          >Contacto</a
        >
      </nav>

      <a
        href="#guia"
        class="hidden sm:inline-flex items-center gap-2 text-[0.85rem] font-semibold text-deep border-b border-deep/30 hover:border-deep pb-0.5 transition-colors"
      >
        Guía gratuita
        <span class="inline-block w-3 h-px bg-leaf-deep"></span>
      </a>
    </div>
  </div>
</header>
