---
import LeafMark from "./LeafMark.astro";
---

<header class="sticky top-0 z-40">
  <div
    class="backdrop-blur-md bg-[color:var(--color-paper)]/75 border-b border-[color:var(--color-rule)]/70"
  >
    <div
      class="max-w-[1240px] mx-auto px-6 md:px-10 flex items-center justify-between h-[72px] gap-6"
    >
      <a href="/" class="flex items-center gap-3 group" aria-label="VirtusWay — inicio">
        <LeafMark size={26} class="transition-transform duration-500 group-hover:rotate-[-6deg]" />
        <span class="flex items-baseline gap-2">
          <span
            class="font-display text-[1.35rem] tracking-[-0.02em] text-[color:var(--color-ink)]"
            style="font-variation-settings: 'opsz' 144, 'SOFT' 50;"
          >
            Virtus<span class="font-display-italic text-[color:var(--color-deep)]">way</span>
          </span>
          <span
            class="hidden sm:inline text-[0.65rem] tracking-[0.22em] uppercase text-[color:var(--color-ink-soft)] font-medium"
          >
            coaching integrativo
          </span>
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-9 text-[0.92rem] text-[color:var(--color-ink)]">
        <a href="#audiencia" class="hover:text-[color:var(--color-deep)] transition-colors"
          >Acompañamiento</a
        >
        <a href="#metodo" class="hover:text-[color:var(--color-deep)] transition-colors">Método</a>
        <a href="#sobre" class="hover:text-[color:var(--color-deep)] transition-colors">Sobre mí</a>
        <a href="#contacto" class="hover:text-[color:var(--color-deep)] transition-colors"
          >Contacto</a
        >
      </nav>

      <a
        href="#guia"
        class="hidden sm:inline-flex items-center gap-2 text-[0.85rem] font-semibold text-[color:var(--color-deep)] border-b border-[color:var(--color-deep)]/30 hover:border-[color:var(--color-deep)] pb-0.5 transition-colors"
      >
        Guía gratuita
        <span class="inline-block w-3 h-px bg-[color:var(--color-leaf-deep)]"></span>
      </a>
    </div>
  </div>
</header>
