<header class="sticky top-0 z-40 transition-all duration-300" id="site-header">
  <div class="backdrop-blur-md bg-paper/75 border-b border-rule/70 transition-all duration-300">
    <div
      class="max-w-310 mx-auto w-full min-w-0 px-6 md:px-10 flex items-center justify-between h-20 sm:h-22 md:h-24 gap-6 transition-all duration-300"
      id="header-inner"
    >
      <a
        href="/"
        class="flex items-center gap-3 md:gap-4 group min-w-0"
        aria-label="VirtusWay — inicio"
      >
        <img
          src="/brand/WEB/Virtusway_Brand_H.svg"
          alt="VirtusWay"
          width="201"
          height="33"
          class="h-8 sm:h-9 w-auto shrink-0 transition-all duration-300 group-hover:opacity-90"
          id="header-logo"
          loading="eager"
          decoding="async"
        />
        <span class="hidden lg:flex min-w-0 flex-col justify-center py-1">
          <span
            class="truncate text-[0.82rem] font-medium leading-[1.35] text-ink"
          >
            Mauricio Magni Manchón
          </span>
          <span
            class="truncate text-[0.62rem] font-medium leading-[1.45] tracking-eyebrow uppercase text-ink-soft"
          >
            coaching integrativo
          </span>
        </span>
      </a>

      <nav
        class="hidden min-w-0 md:flex items-center gap-9 text-[0.92rem] text-ink"
      >
        <a href="/#audiencia" class="hover:text-deep transition-colors"
          >Acompañamiento</a
        >
        <a href="/#metodo" class="hover:text-deep transition-colors">Método</a>
        <a href="/#sobre" class="hover:text-deep transition-colors">Sobre mí</a>
        <a href="/#contacto" class="hover:text-deep transition-colors"
          >Contacto</a
        >
      </nav>

      <a
        href="https://outlook.office.com/bookwithme/user/48d235d03a08496b97d4b477ea665fbb@virtusway.com/meetingtype/l9E3R2UjHUaYl4B09FL6MQ2?anonymous&ep=mlink"
        class="hidden sm:inline-flex items-center gap-2 text-[0.85rem] font-semibold text-deep border-b border-deep/30 hover:border-deep pb-0.5 transition-colors"
      >
        Reservar sesión
        <span class="inline-block w-3 h-px bg-leaf-deep"></span>
      </a>
    </div>
  </div>
</header>

<style>
  /* Transition sizes when scrolled */
  #site-header.scrolled #header-inner {
    height: 3.5rem; /* h-14 */
  }
  @media (min-width: 640px) {
    #site-header.scrolled #header-inner {
      height: 4rem; /* h-16 */
    }
  }
  @media (min-width: 768px) {
    #site-header.scrolled #header-inner {
      height: 4.5rem; /* h-18 */
    }
  }

  #site-header.scrolled #header-logo {
    height: 1.75rem; /* h-7 */
  }
  @media (min-width: 640px) {
    #site-header.scrolled #header-logo {
      height: 2rem; /* h-8 */
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  
  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  };

  // Run immediately to set initial state on page load (e.g. if loaded mid-page)
  handleScroll();

  window.addEventListener('scroll', handleScroll, { passive: true });
</script>

