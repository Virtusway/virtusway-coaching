              >
                MM
              </span>
            </div>
            <div class="mt-6 text-center">
              <p
                class="font-display text-[1.45rem] text-ink"
              >
                Mauricio Magni Manchón
              </p>
              <p class="mt-1 eyebrow">Coach integrativo · Fundador</p>
            </div>
          </div>

          <div class="hairline mt-8"></div>

          <dl class="mt-6 grid grid-cols-3 gap-4 text-center">
            <div>
              <dt class="eyebrow">Años en TIC</dt>
              <dd
                class="mt-1 font-display text-[1.6rem] text-deep"
