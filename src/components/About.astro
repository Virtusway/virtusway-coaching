<section id="sobre" class="relative min-w-0 overflow-hidden bg-gradient-to-b from-paper via-mist-soft/40 to-paper border-y border-rule/30">
  <!-- Decorative background lights -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 -translate-y-1/2 w-[550px] h-[550px] rounded-full bg-sky/8 blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 translate-y-1/2 w-[450px] h-[450px] rounded-full bg-leaf/6 blur-3xl"></div>
  </div>

  <div class="max-w-310 mx-auto w-full min-w-0 px-6 md:px-10 py-20 md:py-28 relative z-10">
    <!-- Section Title (Top of section) -->
    <div class="mb-12 reveal">
      <p class="eyebrow eyebrow-with-rule">
        <span class="w-8 h-px shrink-0 bg-leaf-deep"></span>
        <span class="min-w-0">Sobre mí</span>
      </p>

      <h2
        class="mt-4 max-w-full wrap-break-word font-display text-[2.2rem] md:text-[3.2rem] leading-[1.08] tracking-[-0.03em] text-ink"
      >
        De la
        <span class="font-display-italic text-deep">tecnología</span>
        a las personas.
      </h2>
    </div>

    <div
      class="grid min-w-0 grid-cols-1 gap-12 items-stretch lg:grid-cols-12 lg:gap-x-10 lg:gap-y-12"
    >
      <!-- Portrait card -->
      <div class="min-w-0 lg:col-span-5 reveal lg:h-full">
        <div
          class="relative min-w-0 rounded-4xl p-8 md:p-10 overflow-hidden border border-rule shadow-xs lg:h-full flex flex-col justify-between"
          style="background: linear-gradient(160deg, #ffffff 0%, #eaf3f7 100%);"
        >
          <div
            aria-hidden="true"
            class="absolute -top-12 -right-12 w-65 h-65 rounded-full opacity-40 blur-3xl"
            style="background: radial-gradient(circle, rgba(0,203,151,0.4), transparent 70%);"
          >
          </div>

          <!-- Portrait Photo & Name wrapper -->
          <div class="relative flex-1 flex flex-col justify-center py-6">
            <div
              class="w-45 h-45 mx-auto rounded-full overflow-hidden border border-rule bg-white shadow-md relative group"
            >
              <div
                class="absolute inset-0 bg-gradient-to-tr from-deep/15 via-transparent to-leaf/10 pointer-events-none mix-blend-overlay"
              ></div>
              <img
                src="/personal-image.jpeg"
                alt="Mauricio Magni Manchón — Coach integrativo y fundador de VirtusWay"
                class="w-full h-full object-cover object-[center_30%] transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-6 min-w-0 text-center">
              <p
                class="max-w-full wrap-break-word font-display text-[1.45rem] text-ink"
              >
                Mauricio Magni Manchón
              </p>
              <p class="mt-1 eyebrow">Coach integrativo · Fundador</p>
            </div>
          </div>

          <div class="hairline mt-auto mb-6"></div>

          <dl
            class="grid min-w-0 grid-cols-1 gap-6 text-center sm:grid-cols-3 sm:gap-4"
          >
            <div class="min-w-0">
              <dt class="eyebrow">Años en TIC</dt>
              <dd class="mt-1 font-display text-[1.6rem] text-deep">35</dd>
            </div>
            <div class="min-w-0">
              <dt class="eyebrow">Práctica</dt>
              <dd class="mt-1 font-display text-[1.6rem] text-deep">
                200<span class="text-[1rem] align-top">+ h</span>
              </dd>
            </div>
            <div class="min-w-0">
              <dt class="eyebrow">Formación</dt>
              <dd class="mt-1 font-display text-[1.6rem] text-deep">Máster</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Bio column -->
      <div
        class="min-w-0 lg:col-span-7 reveal lg:h-full flex flex-col"
        style="transition-delay: 100ms;"
      >
        <!-- Bio Paragraphs Grid -->
        <div class="grid min-w-0 grid-cols-1 gap-6 sm:grid-cols-2 lg:h-full lg:grid-rows-2">
          <!-- Card 1 -->
          <div class="group relative min-w-0 rounded-3xl border border-rule/80 bg-white/95 p-6 shadow-[0_4px_20px_-10px_rgba(10,77,122,0.12)] hover:shadow-[0_12px_32px_-12px_rgba(10,77,122,0.2)] hover:bg-white hover:border-leaf/30 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4 border-b border-rule/40 pb-3">
                <span class="eyebrow text-leaf-deep font-semibold">Trayectoria</span>
                <span class="text-xs font-mono text-ink-soft select-none group-hover:text-leaf transition-colors duration-300">TIC</span>
              </div>
              <p class="text-ink-muted text-[0.98rem] leading-[1.6] wrap-anywhere">
                <strong class="font-semibold text-ink">35 años en entornos TIC</strong> como desarrollador, líder de equipos y
                gestor de proyectos complejos. Esa experiencia me enseñó que <strong class="font-semibold text-ink">el verdadero cuello de botella no suele ser técnico</strong>: es la <strong class="font-semibold text-ink">desconexión entre valores, comunicación y propósito</strong>.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="group relative min-w-0 rounded-3xl border border-rule/80 bg-white/95 p-6 shadow-[0_4px_20px_-10px_rgba(10,77,122,0.12)] hover:shadow-[0_12px_32px_-12px_rgba(10,77,122,0.2)] hover:bg-white hover:border-leaf/30 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4 border-b border-rule/40 pb-3">
                <span class="eyebrow text-leaf-deep font-semibold">Formación</span>
                <span class="text-xs font-mono text-ink-soft select-none group-hover:text-leaf transition-colors duration-300">Respaldo</span>
              </div>
              <p class="text-ink-muted text-[0.98rem] leading-[1.6] wrap-anywhere">
                Por eso me formé como <strong class="font-semibold text-ink">coach integrativo</strong> con un <strong class="font-semibold text-ink">Máster en Liderazgo y Business Coaching</strong> (FundAres / Universidad Manresa). <strong class="font-semibold text-ink">Más de 200 horas de práctica</strong> acompañando a personas como tú.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="group relative min-w-0 rounded-3xl border border-rule/80 bg-white/95 p-6 shadow-[0_4px_20px_-10px_rgba(10,77,122,0.12)] hover:shadow-[0_12px_32px_-12px_rgba(10,77,122,0.2)] hover:bg-white hover:border-leaf/30 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4 border-b border-rule/40 pb-3">
                <span class="eyebrow text-leaf-deep font-semibold">Enfoque</span>
                <span class="text-xs font-mono text-ink-soft select-none group-hover:text-leaf transition-colors duration-300">Método</span>
              </div>
              <p class="text-ink-muted text-[0.98rem] leading-[1.6] wrap-anywhere">
                Mi enfoque combina <strong class="font-semibold text-ink">coaching ontológico, análisis transaccional relacional y herramientas de cambio conductual (ACT)</strong>. En la práctica: un <strong class="font-semibold text-ink">espacio sin juicio, preguntas precisas y un acompañamiento realista</strong>.
              </p>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="group relative min-w-0 rounded-3xl border border-rule/80 bg-white/95 p-6 shadow-[0_4px_20px_-10px_rgba(10,77,122,0.12)] hover:shadow-[0_12px_32px_-12px_rgba(10,77,122,0.2)] hover:bg-white hover:border-leaf/30 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4 border-b border-rule/40 pb-3">
                <span class="eyebrow text-leaf-deep font-semibold">Coherencia</span>
                <span class="text-xs font-mono text-ink-soft select-none group-hover:text-leaf transition-colors duration-300">Ética</span>
              </div>
              <p class="text-ink-muted text-[0.98rem] leading-[1.6] wrap-anywhere">
                <strong class="font-semibold text-ink">No creo en las transformaciones mágicas</strong>. Creo en <strong class="font-semibold text-ink">procesos paso a paso, con honestidad y coherencia</strong>. He venido a dar <strong class="font-semibold text-ink">estructura y profundidad</strong> a lo que ya sabía que podía aportar.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
