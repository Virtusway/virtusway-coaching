---
import { randomUUID } from "node:crypto";

interface Props {
  size?: number;
  class?: string;
  /** When true, fills wings with the brand sky-blue gradient and the leaf in
   *  brand mint. When false, all three shapes use `currentColor` so the mark
   *  can be tinted by its parent's text color (useful in dark contexts). */
  brand?: boolean;
}

const { size = 28, class: className = "", brand = true } = Astro.props;

// The favicon's viewBox is 246 × 228 — slightly wider than tall.
const ratio = 228 / 246;
const height = Math.round(size * ratio * 100) / 100;

// Unique IDs per instance prevent gradient collisions when multiple marks
// render on the same page (Header, Hero, Footer, etc.).
const uid = `lm-${randomUUID().slice(0, 8)}`;
const leftGradId = `${uid}-l`;
const rightGradId = `${uid}-r`;

const leftFill = brand ? `url(#${leftGradId})` : "currentColor";
const rightFill = brand ? `url(#${rightGradId})` : "currentColor";
const leafFill = brand ? "#00C894" : "currentColor";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={height}
  viewBox="0 0 246 228"
  aria-hidden="true"
  class={className}
>
  {
    brand && (
      <defs>
        <linearGradient id={leftGradId} x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#5ECAE0" />
          <stop offset="40%" stop-color="#57BDCA" />
          <stop offset="100%" stop-color="#2E94C4" />
        </linearGradient>
        <linearGradient id={rightGradId} x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#79CDE6" />
          <stop offset="50%" stop-color="#5CC2E4" />
          <stop offset="100%" stop-color="#59B7DB" />
        </linearGradient>
      </defs>
    )
  }

