---
export interface Testimonial {
  quote: string;
  author?: string;
  role?: string;
  location?: string;
  tag?: string;
}

interface Props {
  testimonials?: Testimonial[];
}

const defaultTestimonials: Testimonial[] = [
  {
    quote: "Una de las cosas que más valoro es que consigues crear un espacio de confianza en el que es fácil abrirse. Mantendría esa cercanía, porque creo que marca una gran diferencia.",
    author: "Cliente de Coaching Individual",
    role: "Encuesta anónima de satisfacción",
    location: "Confidencial",
    tag: "Espacio de confianza"
  },
  {
    quote: "Para mí fue un espacio de reflexión y de replanteos que me ayudó a ver cosas de mí misma. Quedé muy agradecida.",
    author: "Participante Proceso 1 a 1",
    role: "Encuesta anónima de satisfacción",
    location: "Confidencial",
    tag: "Reflexión y claridad"
  },
  {
    quote: "Estoy muy satisfecha con las sesiones. Me siento escuchada y considero que el enfoque ha sido muy útil.",
    author: "Cliente de Coaching Individual",
    role: "Encuesta anónima de satisfacción",
    location: "Confidencial",
    tag: "Sesiones individuales"
  }
];

const { testimonials = defaultTestimonials } = Astro.props;
---

<section id="testimonios" class="relative min-w-0 overflow-hidden bg-linear-to-b from-paper to-mist-soft/20 border-t border-rule/30">
  <div class="max-w-310 mx-auto w-full min-w-0 px-6 md:px-10 py-20 md:py-28 relative z-10">
    
    <!-- Header -->
    <div class="max-w-2xl reveal">
      <p class="eyebrow eyebrow-with-rule">
        <span class="w-8 h-px shrink-0 bg-leaf-deep"></span>
        <span class="min-w-0">Opiniones</span>
      </p>
      <h2 class="mt-4 font-display text-[2.2rem] md:text-[3.1rem] leading-[1.05] tracking-[-0.03em] text-ink">
        Lo que dicen <span class="font-display-italic text-deep">quienes han trabajado</span> conmigo
      </h2>
      <p class="mt-3 text-sm text-ink-muted leading-relaxed">
        Testimonios reales extraídos de encuestas anónimas de satisfacción tras completar el proceso de coaching.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="mt-16 md:mt-20 grid min-w-0 grid-cols-1 gap-px bg-rule border border-rule rounded-[28px] overflow-hidden md:grid-cols-3">
      {testimonials.map((t, i) => (
        <article 
          class="min-w-0 bg-paper p-8 md:p-10 flex flex-col justify-between reveal hover:bg-mist-soft/30 transition-colors duration-500 min-h-80"
          style={`transition-delay: ${i * 80}ms;`}
        >
          <!-- Quote Icon and Text -->
          <div class="relative min-w-0 flex-1">
            <span class="absolute -top-6 -left-2 select-none pointer-events-none text-[5rem] font-serif text-leaf-deep/8 leading-none" aria-hidden="true">
              “
            </span>
            <p class="relative z-10 text-[0.98rem] leading-relaxed text-ink-muted italic">
              {t.quote}
            </p>
          </div>

          <!-- Divider -->
          <div class="hairline my-6"></div>

          <!-- Author Info -->
          <div class="flex min-w-0 items-center justify-between gap-3">
            <div class="min-w-0 flex-1">
              <p class="font-display text-[1.02rem] text-ink truncate">{t.author || "Cliente de Coaching"}</p>
              {t.role && <p class="text-[0.78rem] text-ink-muted truncate">{t.role}</p>}
            </div>
            {(t.tag || t.location) && (
              <span class="shrink-0 text-[0.75rem] font-semibold text-on-dark-accent bg-leaf-deep/10 px-3 py-1.5 rounded-full">
                {t.tag || t.location}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
