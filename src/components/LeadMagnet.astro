<section id="guia" class="relative min-w-0">
  <div class="lead-toast-stack" aria-live="polite" aria-atomic="true">
    <div class="lead-toast" data-feedback-toast data-state="idle" hidden>
      <p class="lead-toast__eyebrow" data-toast-eyebrow>Entrega completada</p>
      <p class="lead-toast__message" data-toast-message></p>
    </div>
  </div>

  <div class="max-w-310 mx-auto w-full min-w-0 px-6 md:px-10 py-20 md:py-28">
    <div
      class="relative min-w-0 overflow-hidden rounded-[36px] reveal"
      style="background: linear-gradient(160deg, #0a4d7a 0%, #082438 70%, #061a28 100%);"
    >
      <!-- Decorative atmosphere -->
      <div
        aria-hidden="true"
        class="absolute -top-32 -right-24 w-115 h-115 rounded-full opacity-50 blur-3xl"
        style="background: radial-gradient(circle, rgba(0,203,151,0.5), transparent 70%);"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute -bottom-32 -left-24 w-115 h-115 rounded-full opacity-30 blur-3xl"
        style="background: radial-gradient(circle, rgba(82,194,230,0.4), transparent 70%);"
      >
      </div>

      <!-- Faint topography texture -->
      <div
        aria-hidden="true"
        class="absolute inset-0 contour opacity-[0.4] mix-blend-overlay"
      >
      </div>

      <div
        class="relative grid min-w-0 grid-cols-1 gap-6 p-5 text-paper sm:p-8 md:gap-y-10 md:p-14 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-6 lg:p-20"
      >
        <!-- Copy column -->
        <div class="min-w-0 lg:col-span-7">
          <p class="eyebrow eyebrow-with-rule text-on-dark-accent">
            <span class="w-8 h-px shrink-0 bg-on-dark-accent"></span>
            <span class="min-w-0">Guía gratuita · PDF</span>
          </p>

          <h2
            class="mt-5 max-w-full min-w-0 wrap-break-word font-display text-[1.85rem] leading-[1.08] tracking-[-0.03em] sm:text-[2.2rem] md:text-[3.4rem] md:leading-[1.02]"
          >
            5 preguntas para conectar con tus
            <span class="font-display-italic text-on-dark-accent">valores</span>
            <span class="block">y tomar decisiones con claridad.</span>
          </h2>

          <p
            class="mt-7 max-w-full min-w-0 text-[1.05rem] leading-[1.7] text-on-dark-muted sm:max-w-136"
          >
            Inspirada en la psicología humanista, el coaching de valores y la
            filosofía práctica. Una guía breve para distinguir lo que realmente
            importa de lo que crees que debería importarte, y dar el primer paso
            más honesto posible.
          </p>

          <ul
            class="mt-8 grid min-w-0 grid-cols-1 gap-x-4 gap-y-3 text-[0.95rem] text-on-dark-muted sm:grid-cols-2 sm:gap-x-6"
          >
            <li class="flex min-w-0 items-baseline gap-3">
              <span class="numeral shrink-0 text-[1rem] text-on-dark-accent"
                >01</span
              >
              <span class="min-w-0"
                >Identificar qué valores están en conflicto en tu día a día</span
              >
            </li>
            <li class="flex min-w-0 items-baseline gap-3">
              <span class="numeral shrink-0 text-[1rem] text-on-dark-accent"
                >02</span
              >
              <span class="min-w-0"
                >Diferenciar lo que deseas de lo que crees que deberías desear</span
              >
            </li>
            <li class="flex min-w-0 items-baseline gap-3 sm:col-span-2">
              <span class="numeral shrink-0 text-[1rem] text-on-dark-accent"
                >03</span
              >
              <span class="min-w-0"
                >Tomar una decisión más clara sobre si el coaching tiene sentido
                para ti</span
              >
            </li>
          </ul>
        </div>

        <!-- Form column -->
        <div class="min-w-0 lg:col-span-5">
          <form
            data-lead-magnet-form
            class="min-w-0 rounded-3xl p-7 md:p-8 border"
            style="background: rgba(255,255,255,0.06); border-color: rgba(203,220,229,0.2); backdrop-filter: blur(6px);"
          >
            <div class="flex min-w-0 items-center gap-3">
              <img
                src="/brand/ISO/Web/Virtusway_ISO.svg"
                alt=""
                width="30"
                height="29"
                class="h-7 w-auto shrink-0"
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <p class="min-w-0 font-display text-[1.2rem]">
                Recibe tu copia ahora
              </p>
            </div>

            <div class="mt-6 space-y-3">
              <label class="block">
                <span class="sr-only">Nombre</span>
                <input
                  type="text"
                  name="nombre"
                  placeholder="Tu nombre (opcional)"
                  class="field"
                  style="background: rgba(255,255,255,0.92); color: var(--color-ink);"
                />
              </label>
              <label class="block">
                <span class="sr-only">Email</span>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="tu@correo.com"
                  class="field"
                  style="background: rgba(255,255,255,0.92); color: var(--color-ink);"
                />
              </label>
              <label
                class="flex min-w-0 cursor-pointer gap-3 rounded-2xl border border-white/15 bg-white/[0.07] p-4 text-[0.82rem] leading-relaxed text-on-dark-muted transition-colors hover:border-leaf/40"
              >
                <input
                  type="checkbox"
                  name="commercialConsent"
                  value="yes"
                  required
                  class="mt-1 h-4 w-4 shrink-0 rounded border-on-dark-muted/60 bg-white/90"
                  style="accent-color: var(--color-leaf);"
                />
                <span class="min-w-0">
                  Doy mi consentimiento para que VirtusWay me contacte con
                  objetivos comerciales relacionados con sus servicios de
                  coaching a cambio de recibir el PDF. Puedo revocar este
                  consentimiento en cualquier momento desde la
                  <a
                    href="/revocar-consentimiento"
                    class="text-on-dark-accent underline decoration-on-dark-accent/50 underline-offset-3 hover:decoration-on-dark-accent"
                    >página de revocación</a
                  >.
                </span>
              </label>
              <button
                type="submit"
                data-submit-button
                disabled
                class="btn btn-primary w-full cursor-pointer justify-center bg-leaf! text-ink! hover:bg-leaf-deep! hover:text-paper! disabled:cursor-not-allowed disabled:opacity-45"
              >
                <span data-submit-label>Descarga gratuita</span>
                <span class="arrow" aria-hidden="true">→</span>
              </button>
            </div>

            <p
              class="mt-4 form-status"
              data-form-status
              data-state="idle"
              role="status"
              aria-live="polite"
            >
            </p>

            <p class="mt-3 text-[0.78rem] leading-relaxed text-on-dark-soft">
              Te enviaremos el enlace de descarga por email y registraremos tu
              consentimiento para poder contactarte con fines comerciales.
              Puedes retirarlo en cualquier momento.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-lead-magnet-form]").forEach((form) => {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    const section = form.closest("section");
    const emailInput = form.querySelector('input[name="email"]');
    const consentInput = form.querySelector('input[name="commercialConsent"]');
    const button = form.querySelector("[data-submit-button]");
    const label = form.querySelector("[data-submit-label]");
    const status = form.querySelector("[data-form-status]");
    const toast = section?.querySelector("[data-feedback-toast]");
    const toastEyebrow = section?.querySelector("[data-toast-eyebrow]");
    const toastMessage = section?.querySelector("[data-toast-message]");

    if (
      !(emailInput instanceof HTMLInputElement) ||
      !(consentInput instanceof HTMLInputElement) ||
      !(button instanceof HTMLButtonElement) ||
      !(label instanceof HTMLElement) ||
      !(status instanceof HTMLElement) ||
      !(toast instanceof HTMLElement) ||
      !(toastEyebrow instanceof HTMLElement) ||
      !(toastMessage instanceof HTMLElement)
    ) {
      return;
    }

    const defaultLabel = label.textContent ?? "Descarga gratuita";
    let toastTimer;
    let isSubmitting = false;

    const canSubmit = () => {
      const hasEmail = emailInput.value.trim().length > 0;
      return hasEmail && emailInput.validity.valid && consentInput.checked;
    };

    const updateSubmitAvailability = () => {
      button.disabled = isSubmitting || !canSubmit();
    };

    emailInput.addEventListener("input", updateSubmitAvailability);
    consentInput.addEventListener("change", updateSubmitAvailability);
    updateSubmitAvailability();

    const setStatus = (message, state) => {
      status.textContent = message;
      status.dataset.state = state;
    };

    const showToast = (message, state) => {
      window.clearTimeout(toastTimer);

      toast.hidden = false;
      toast.dataset.state = state;
      toastEyebrow.textContent =
        state === "success" ? "Correo enviado" : "No se pudo enviar";
      toastMessage.textContent = message;

      toastTimer = window.setTimeout(() => {
        toast.hidden = true;
        toast.dataset.state = "idle";
      }, 4800);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!canSubmit()) {
        updateSubmitAvailability();
        return;
      }

      isSubmitting = true;
      updateSubmitAvailability();
      label.textContent = "Enviando...";
      setStatus("Preparando tu guía...", "pending");
      toast.hidden = true;
      toast.dataset.state = "idle";

      try {
        const response = await fetch("/api/lead-magnet", {
          method: "POST",
          body: new FormData(form),
        });
        const payload = await response.json().catch(() => null);
        const message =
          payload && typeof payload.message === "string"
            ? payload.message
            : "Ha ocurrido un error inesperado.";

        if (!response.ok) {
          throw new Error(message);
        }

        form.reset();
        label.textContent = defaultLabel;
        updateSubmitAvailability();
        setStatus(message, "success");
        showToast(message, "success");
      } catch (error) {
        label.textContent = defaultLabel;
        const message =
          error instanceof Error
            ? error.message
            : "No se pudo enviar la guía. Inténtalo de nuevo.";
        setStatus(message, "error");
        showToast(message, "error");
      } finally {
        isSubmitting = false;
        updateSubmitAvailability();
      }
    });
  });
</script>
