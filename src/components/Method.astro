---
const pillars = [
  {
    n: "01",
    title: "Conectar ideas",
    italic: "cabeza",
    body: "Acompaño a que descubráis vuestros pensamientos, sentimientos y dónde viven vuestras creencias más profundas.",
    glyph: "M8 32 C 16 18, 24 46, 32 32 S 48 18, 56 32",
  },
  {
    n: "02",
    title: "Superar limitaciones",
    italic: "emoción",
    body: "Facilito que identifiquemos patrones de auto-sabotaje, culpa o miedo, no para etiquetarlos sino para desactivarlos con herramientas concretas.",
    glyph: "M14 50 L 32 14 L 50 50 M22 38 H 42",
  },
  {
    n: "03",
    title: "Actuar con coherencia",
    italic: "acción",
    body: "Creamos juntos prácticas, experimentos y compromisos pequeños que transforman la conversación en acción. Paso a paso. Sin magia, con método.",
    glyph: "M12 32 H 32 V 12 M32 32 L 52 52 M32 32 V 52",
  },
];
---

<section id="metodo" class="relative">
  <!-- Subtle paper-warm band -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div
      class="absolute inset-x-0 top-0 bottom-0"
      style="background: linear-gradient(180deg, transparent 0%, rgba(248,245,238,0.55) 22%, rgba(248,245,238,0.55) 78%, transparent 100%);"
    >
    </div>
  </div>

  <div class="max-w-310 mx-auto w-full min-w-0 px-6 md:px-10 py-20 md:py-28">
    <!-- Heading -->
    <div
      class="grid min-w-0 grid-cols-1 gap-8 items-end reveal lg:grid-cols-12 lg:gap-x-8 lg:gap-y-0"
    >
      <div class="min-w-0 lg:col-span-7">
        <p class="eyebrow eyebrow-with-rule">
          <span class="w-8 h-px shrink-0 bg-leaf-deep"></span>
          <span class="min-w-0">Método</span>
        </p>
        <h2
          class="mt-4 font-display text-[2.2rem] md:text-[3.1rem] leading-[1.05] tracking-[-0.03em] text-ink"
        >
          Conversaciones que conectan
          <span class="font-display-italic text-deep">
            cabeza, emoción y acción
          </span>
        </h2>
      </div>
      <p
        class="min-w-0 lg:col-span-5 text-[1.02rem] text-ink-muted leading-relaxed"
      >
        Una conversación estructurada: visión humanista, coaching de valores y
        neurociencia. Un proceso a tu ritmo, con tus decisiones, sin recetas
        prefabricadas.
      </p>
    </div>

    <!-- Pillars grid -->
    <div
      class="mt-16 md:mt-20 grid min-w-0 grid-cols-1 gap-px bg-rule border border-rule rounded-[28px] overflow-hidden md:grid-cols-3"
    >
      {
        pillars.map((p, i) => (
          <article
            class="min-w-0 bg-paper p-8 md:p-10 min-h-90 flex flex-col reveal hover:bg-mist-soft transition-colors duration-500"
            style={`transition-delay: ${i * 80}ms;`}
          >
            <div class="flex min-w-0 items-center justify-between">
              <span class="numeral text-[1.8rem]">{p.n}</span>
              <svg
                width="48"
                height="32"
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-tide opacity-70"
                aria-hidden="true"
              >
                <path d={p.glyph} />
              </svg>
            </div>

            <h3 class="mt-12 md:mt-16 font-display text-[1.65rem] md:text-[1.85rem] leading-[1.1] tracking-[-0.02em] text-ink">
              {p.title}
              <span class="block font-display-italic text-leaf-deep text-[1.05rem] mt-2 tracking-normal">
                — hacia la {p.italic}
              </span>
            </h3>

            <p class="mt-5 text-[0.98rem] leading-[1.65] text-ink-muted">
              {p.body}
            </p>
          </article>
        ))
      }
    </div>

    <!-- Quiet quote strip -->
    <div class="mt-16 md:mt-20 max-w-3xl mx-auto text-center reveal">
      <p
        class="font-display text-[1.4rem] md:text-[1.7rem] leading-[1.45] tracking-[-0.015em] text-ink"
      >
        <span class="font-display-italic text-leaf-deep">"</span>Sin
        <span class="font-display-italic text-deep">magia</span>, con
        <span class="font-display-italic text-deep">método</span>, para que la
        conversación se convierta en una práctica
        <span class="font-display-italic text-leaf-deep">sostenible</span>.<span class="font-display-italic text-leaf-deep">"</span>
      </p>
    </div>
  </div>
</section>
