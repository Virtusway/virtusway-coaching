---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  eyebrow: string;
  heroTitle: string;
  /** A word inside heroTitle to highlight in italic deep blue. Optional. */
  italicAccent?: string;
  /** Subtitle/lead under the title */
  lead?: string;
  /** Last updated date (display string) */
  lastUpdated?: string;
}

const {
  title,
  description,
  eyebrow,
  heroTitle,
  italicAccent,
  lead,
  lastUpdated = "Pendiente de publicación",
} = Astro.props;

// Render heroTitle, replacing italicAccent with an italic-styled span
const renderTitle = () => {
  if (!italicAccent) return heroTitle;
  const idx = heroTitle.toLowerCase().indexOf(italicAccent.toLowerCase());
  if (idx === -1) return heroTitle;
  const before = heroTitle.slice(0, idx);
  const accent = heroTitle.slice(idx, idx + italicAccent.length);
  const after = heroTitle.slice(idx + italicAccent.length);
  return { before, accent, after };
};

const parts = renderTitle();
const isSplit = typeof parts !== "string";
---

<Layout title={`${title} · VirtusWay`} description={description}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 pointer-events-none"
      >
        <div
          class="absolute -top-32 -right-24 w-130 h-130 rounded-full opacity-30 blur-3xl"
          style="background: radial-gradient(circle at 50% 50%, rgba(143,198,223,0.5), transparent 60%);"
        >
        </div>
      </div>

      <div
        class="max-w-275 mx-auto px-6 md:px-10 pt-12 md:pt-16 pb-10 md:pb-14"
      >
        <a
          href="/"
          class="inline-flex items-center gap-2 eyebrow hover:text-deep transition-colors"
        >
          <span aria-hidden="true">←</span>
          Volver a VirtusWay
        </a>

        <div class="mt-10 grid grid-cols-12 gap-8 items-end">
          <div class="col-span-12 lg:col-span-9">
            <p class="eyebrow flex items-center gap-3">
              <span class="w-8 h-px bg-leaf-deep"></span>
              {eyebrow}
            </p>

            <h1
              class="mt-5 font-display text-[2.4rem] md:text-[3.6rem] leading-[1.04] tracking-[-0.035em] text-ink rise"
            >
              {
                isSplit ? (
                  <>
                    {parts.before}
                    <span
                      class="font-display-italic text-deep"
                    >
                      {parts.accent}
                    </span>
                    {parts.after}
                  </>
                ) : (
                  parts
                )
              }
            </h1>

            {
              lead && (
                <p class="mt-6 max-w-2xl text-[1.05rem] md:text-[1.12rem] leading-[1.65] text-ink-muted">
                  {lead}
                </p>
              )
            }
          </div>

          <div class="col-span-12 lg:col-span-3 lg:text-right">
            <p class="eyebrow">Última actualización</p>
            <p class="mt-2 font-sans text-leaf-deep text-[1.05rem] font-semibold">
              {lastUpdated}
            </p>
          </div>
        </div>

        <div class="hairline mt-12 md:mt-16"></div>
      </div>
    </section>

    <!-- Document body -->
    <section class="relative">
      <div class="max-w-275 mx-auto px-6 md:px-10 pb-20 md:pb-28">
        <article class="grid grid-cols-12 gap-10">
          <div class="hidden lg:block lg:col-span-1">
            <!-- left margin gutter for breathing room / future TOC -->
          </div>
          <div class="col-span-12 lg:col-span-10 prose-legal">
            <slot />
          </div>
        </article>

        <!-- Closing strip -->
        <div class="mt-20 md:mt-28">
          <div class="hairline"></div>
          <div
            class="mt-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6"
          >
            <p
              class="font-display text-[1.35rem] md:text-[1.55rem] leading-snug text-ink max-w-2xl"
            >
              ¿Tienes alguna duda?
              <span class="font-display-italic text-deep"> Escríbeme. </span>
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a href="mailto:coach@virtusway.com" class="btn btn-ghost">
                coach@virtusway.com
              </a>
              <a href="/" class="btn btn-primary">
                Volver al inicio
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <!-- Cross-links -->
          <nav
            class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 text-[0.9rem]"
          >
            <a
              href="/legal/aviso-legal"
              class="block rounded-2xl border border-rule px-5 py-4 hover:border-deep transition-colors"
            >
              <span class="eyebrow">01</span>
              <span class="block mt-2 font-display text-[1.05rem]"
                >Aviso legal</span
              >
            </a>
            <a
              href="/legal/politica-privacidad"
              class="block rounded-2xl border border-rule px-5 py-4 hover:border-deep transition-colors"
            >
              <span class="eyebrow">02</span>
              <span class="block mt-2 font-display text-[1.05rem]"
                >Privacidad</span
              >
            </a>
            <a
              href="/legal/politica-cookies"
              class="block rounded-2xl border border-rule px-5 py-4 hover:border-deep transition-colors"
            >
              <span class="eyebrow">03</span>
              <span class="block mt-2 font-display text-[1.05rem]">Cookies</span
              >
            </a>
            <a
              href="/legal/compromiso-etico"
              class="block rounded-2xl border border-rule px-5 py-4 hover:border-deep transition-colors"
            >
              <span class="eyebrow">04</span>
              <span class="block mt-2 font-display text-[1.05rem]"
                >Ética · EMCC</span
              >
            </a>
          </nav>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
