---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

const guideHref = "/Virtusway_Valores_v4-1.pdf";
const guideFilename = "Virtusway_Valores_v4-1.pdf";
---

<Layout
  title="Descarga tu guía · VirtusWay"
  description="Descarga la guía gratuita de VirtusWay: 5 preguntas para conectar con tus valores y tomar decisiones con claridad."
>
  <Header />

  <main>
    <section class="relative overflow-hidden">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 pointer-events-none"
      >
        <div
          class="absolute -top-28 -right-24 h-120 w-120 rounded-full opacity-30 blur-3xl"
          style="background: radial-gradient(circle at 50% 50%, rgba(82,194,230,0.5), transparent 62%);"
        >
        </div>
        <div
          class="absolute bottom-0 -left-24 h-110 w-110 rounded-full opacity-20 blur-3xl"
          style="background: radial-gradient(circle at 50% 50%, rgba(0,203,151,0.42), transparent 64%);"
        >
        </div>
      </div>

      <div
        class="max-w-275 mx-auto w-full min-w-0 px-6 md:px-10 py-20 md:py-28"
      >
        <article
          class="relative min-w-0 overflow-hidden rounded-[34px] border border-rule bg-paper-warm/80 p-8 shadow-[0_24px_70px_rgba(10,77,122,0.12)] md:p-12 lg:p-16"
        >
          <div
            aria-hidden="true"
            class="contour absolute inset-0 opacity-[0.28] mix-blend-multiply"
          >
          </div>

          <div class="relative max-w-3xl">
            <p class="eyebrow eyebrow-with-rule">
              <span class="w-8 h-px shrink-0 bg-leaf-deep"></span>
              <span class="min-w-0">Guía gratuita · PDF</span>
            </p>

            <h1
              class="mt-5 font-display text-[2.35rem] leading-[1.04] tracking-[-0.035em] text-ink md:text-[4rem]"
            >
              Tu descarga empieza
              <span class="font-display-italic text-deep"> ahora.</span>
            </h1>

            <p
              class="mt-6 max-w-2xl text-[1.05rem] leading-[1.75] text-ink-muted md:text-[1.12rem]"
            >
              Estamos preparando <strong
                >“5 preguntas para conectar con tus valores y tomar decisiones
                con claridad”</strong
              >. Si el PDF no se descarga automáticamente, puedes abrirlo con el
              botón.
            </p>

            <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
              <a
                id="manual-download"
                href={guideHref}
                download={guideFilename}
                class="btn btn-primary justify-center"
              >
                Descargar PDF
                <span class="arrow" aria-hidden="true">→</span>
              </a>
              <a href="/#guia" class="btn btn-ghost justify-center">
                Volver a VirtusWay
              </a>
            </div>

            <noscript>
              <p class="mt-6 text-[0.95rem] leading-relaxed text-ink-muted">
                Tu navegador tiene JavaScript desactivado. Usa el botón
                “Descargar PDF” para abrir la guía.
              </p>
            </noscript>
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script define:vars={{ guideHref, guideFilename }}>
  window.setTimeout(() => {
    const link = document.createElement("a");
    link.href = guideHref;
    link.download = guideFilename;
    link.style.display = "none";
    document.body.appendChild(link);
    link.click();
    link.remove();
  }, 450);
</script>
