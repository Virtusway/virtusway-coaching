---
import About from "../components/About.astro";
import Audience from "../components/Audience.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
import Method from "../components/Method.astro";
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/Testimonials.astro";

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "VirtusWay — Mauricio Magni",
  image: "https://virtusway.com/personal-image.jpeg",
  logo: "https://virtusway.com/brand/WEB/VIrtusway_Brand_Square.svg",
  "@id": "https://virtusway.com/#organization",
  url: "https://virtusway.com",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle Giacomo Puccini, 21",
    addressLocality: "Puerto de Sagunto",
    addressRegion: "Valencia",
    postalCode: "46520",
    addressCountry: "ES",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "18:00",
  },
  founder: {
    "@type": "Person",
    name: "Mauricio Magni Manchón",
    jobTitle: "Coach integrativo",
    sameAs: ["https://www.linkedin.com/in/mauricio-magni-manchon/"],
  },
  knowsAbout: [
    "Coaching ejecutivo",
    "Liderazgo de equipos TIC",
    "Coaching para mujeres directivas",
  ],
  sameAs: [
    "https://www.linkedin.com/in/mauricio-magni-manchon/",
    "https://www.instagram.com/virtuswaycoach",
  ],
  description:
    "Coaching integrativo para mujeres profesionales y equipos TIC. Liderazgo con coherencia, claridad y método. Valencia y online.",
};

const showTestimonials = true;
---

<Layout
  title="VirtusWay — Coaching para mujeres y equipos TIC"
  description="Liderar con coherencia y claridad. Coaching integrativo para mujeres profesionales y equipos TIC, con una gestión más armónica, tranquilidad y eficiencia."
  schemaMarkup={homeSchema}
>
  <Header />
  <main>
    <Hero />
    <Audience />
    <Method />
    <About />
    <LeadMagnet />
    <FinalCTA />
    {showTestimonials && <Testimonials />}
  </main>
  <Footer />
</Layout>
